# Solo tráfico de NUESTRA zona de Cloudflare: la Transform Rule "Cabecera origen" añade este secreto (.env)
(origen) {
    @sin_secreto not header X-Origen-Secreto {$ORIGEN_SECRETO}
    respond @sin_secreto 403
}

# portal en dominio definitivo (detrás de Cloudflare Access)
zac2zac.com, www.zac2zac.com {
    route {
        import origen
        redir /finanzas /finanzas/
        handle /finanzas/* {
            route {
                forward_auth 172.18.0.1:8791 {
                    uri /_auth
                    copy_headers X-Portal-Censura  # modo censurado del portal (1/0), lo lee la llave
                }
                uri strip_prefix /finanzas
                reverse_proxy 172.18.0.1:8790
            }
        }
        handle {
            reverse_proxy 172.18.0.1:8791
        }
    }
}

# WebDAV para Remotely Save (Cloudflare sin Access; auth propia de rclone)
dav.zac2zac.com {
    route {
        import origen
        handle /webdav/* {
            reverse_proxy webdav:8080
        }
        respond 404
    }
}

# MCP de vault y finanzas: login OAuth (Google) en mcp-auth / mcp-fin-auth
mcp.zac2zac.com {
    route {
        import origen
        reverse_proxy mcp-auth:80
    }
}

mcp-fin.zac2zac.com {
    route {
        import origen
        reverse_proxy mcp-fin-auth:80
    }
}
