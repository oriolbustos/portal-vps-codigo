testobm.duckdns.org {
    handle /webdav/* {
        reverse_proxy webdav:8080
    }
    handle_path /{$MCP_VAULT_RUTA}/* {
        reverse_proxy mcp:8000
    }
    handle_path /{$MCP_JUDIT_RUTA}/* {
        reverse_proxy mcp-judit:8000
    }
    redir /finanzas /finanzas/
    handle /finanzas/* {
        route {
            forward_auth 172.18.0.1:8791 {
                uri /_auth
                copy_headers X-Portal-Censura  # modo censurado del portal (1/0), lo lee la llave
            }
            uri strip_prefix /finanzas
            reverse_proxy 172.18.0.1:8790
        }
    }
    handle_path /{$FIN_MCP_TOKEN}/* {
        reverse_proxy mcp-finanzas:8000
    }
    handle {
        reverse_proxy 172.18.0.1:8791
    }
}

# web publica: pagina minima inline (sin volumen ni compose)
oriolbustos.com, www.oriolbustos.com {
    header Content-Type "text/html; charset=utf-8"
    respond `<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>Oriol Bustos</title>
<style>body{font-family:Times,"Times New Roman",serif;max-width:560px;margin:60px auto;padding:0 16px;line-height:1.5;color:#000;background:#fff}a{color:#00e}</style>
</head><body>
<p>Oriol Bustos</p>
<p><a href="https://www.linkedin.com/in/oriolbustos">linkedin</a></p>
</body></html>
` 200
}

# portal (mismo que testobm, dominio definitivo)
zac2zac.com, www.zac2zac.com {
