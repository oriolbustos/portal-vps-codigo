[Unit]
# Sin límite de arranques: varios cambios seguidos desde el portal lo lanzan muchas veces en pocos segundos
StartLimitIntervalSec=0
Description=Escribe en el vault la nota de ámbito editada desde el panel Tareas del portal

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /opt/portal/tareas-guardar.py
